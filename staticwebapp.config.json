{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "auth": {
    "rolesSource": "/api/roles"
  },
  "routes": [
    {
      "route": "/api/employees",
      "methods": ["PUT"],
      "allowedRoles": ["admin"]
    },
    {
      "route": "/api/teams",
      "methods": ["PUT"],
      "allowedRoles": ["admin"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*.{png,jpg,gif,svg}", "/css/*", "/api/*"]
  },
  "responseOverrides": {
    "401": { "statusCode": 401 },
    "403": { "statusCode": 403 }
  }
}
